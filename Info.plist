<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSAppTransportSecurity</key>
	<dict>
		<!-- Plex servers are often reached over plain http on a LAN address
		     (and AetherEngine's loopback HLS is http://127.0.0.1). Scope the
		     ATS exception to local networking; public hostnames use https. -->
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<!-- macOS asks before an app reaches local-network addresses, including
	     *.plex.direct names that resolve to a LAN IP. -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>Mezzanine connects to your Plex Media Server, which is usually on your local network.</string>
	<!-- Generate from Speech and Match Timing to Speech recognize the film's dialogue on
	     this Mac (never the microphone). -->
	<!-- Google Cast: finding TVs with Chromecast built in on the local network. -->
	<key>NSBonjourServices</key>
	<array>
		<string>_googlecast._tcp</string>
	</array>
	<!-- Software updates (Sparkle). Release builds only; the feed and DMGs live in the public
	     ahamedzoha/mezzanine-releases repo, signed with the EdDSA key in the owner's Keychain
	     (account "mezzanine"). Updates download in the background and install on quit. -->
	<key>SUFeedURL</key>
	<string>https://raw.githubusercontent.com/ahamedzoha/mezzanine-releases/main/appcast.xml</string>
	<key>SUPublicEDKey</key>
	<string>HDEHLe7NE5Q5xsgGP/tY52VwfRYt4qX57YnOSvqmXj0=</string>
	<key>SUEnableAutomaticChecks</key>
	<true/>
	<key>SUAutomaticallyUpdate</key>
	<true/>
	<key>SUScheduledCheckInterval</key>
	<integer>14400</integer>
	<!-- Sandboxed: Sparkle's installer runs as an XPC service launched for the app. -->
	<key>SUEnableInstallerLauncherService</key>
	<true/>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Mezzanine turns a video’s dialogue into subtitles and matches subtitle timing to it. The audio is processed on this Mac and never sent anywhere.</string>
</dict>
</plist>
